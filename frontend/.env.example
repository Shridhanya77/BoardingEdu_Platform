# BoardingEdu Frontend — Environment Variables (example)
# Copy to .env for local development. Vercel: set in project settings.
# NO trailing slash, NO trailing period.

# Option 1 — Local backend (must run: cd backend ; python app.py)
# VITE_API_BASE_URL=http://localhost:5000/api

# Option 2 — Hosted Render backend (works without running Python locally)
# VITE_API_BASE_URL=https://boardingedu-platform-1.onrender.com/api

