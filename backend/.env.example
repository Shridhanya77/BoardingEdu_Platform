# BoardingEdu Backend — Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# PostgreSQL (REQUIRED for local development of this project)
# 1) Install PostgreSQL and remember the postgres user password
# 2) Put that password below (replace YOUR_PASSWORD)
# 3) Run: python setup_postgres.py
# 4) Run: python seed.py
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/boardingedu

# Hosted (Render) example:
# DATABASE_URL=postgresql://user:password@host:5432/boardingedu

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo accounts used ONLY by seed.py (change these in your local .env)
DEMO_ADMIN_EMAIL=admin@boardingedu.demo
DEMO_ADMIN_PASSWORD=AdminDemo@123
DEMO_PARENT_EMAIL=parent@boardingedu.demo
DEMO_PARENT_PASSWORD=ParentDemo@123
